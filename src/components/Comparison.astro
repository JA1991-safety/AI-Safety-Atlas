---
// How the profiled area's approach compares with the other pilot areas, by structure,
// plus the approaches countries use and the international frameworks they share.
import Cite from './Cite.astro';
import { LABELS, fmtDate } from '../lib/site.mjs';

const { p, idx, areaNames, home } = Astro.props as any;
const sec = p.comparison;
const value = { yes: 1, partly: 0.5, no: 0 } as Record<string, number>;
const score = (answers: Record<string, string>) => sec.criteria.reduce((t: number, c: any) => t + value[answers[c.key]], 0);
const max = sec.criteria.length;
const rows = sec.areas
  .map((a: any) => ({ ...a, name: areaNames[a.code] ?? a.code, score: score(a.answers) }))
  .sort((a: any, b: any) => b.score - a.score || a.name.localeCompare(b.name));
const homeAnswers = Object.fromEntries(sec.criteria.map((c: any) => [c.key, c.home]));
const bands = [
  { id: 'closest', title: `Most similar to the ${home.short} approach`, test: (s: number) => s >= max - 1 },
  { id: 'partly', title: 'Partly similar', test: (s: number) => s < max - 1 && s > max / 2 - 0.5 },
  { id: 'divergent', title: 'Most different', test: (s: number) => s <= max / 2 - 0.5 },
];
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---
<section id="compare" class="section" aria-labelledby="h-compare">
  <header class="section-head">
    <h2 id="h-compare">How the {home.short} approach compares</h2>
    <p class="section-meta mono">
      Checked {fmtDate(sec.meta.checked)} · {LABELS.evidence_depth[sec.meta.evidence_depth]} · {LABELS.review[sec.meta.review]}
    </p>
  </header>
  <p class="analysis-note">
    <span class="pill pill-analysis">Analysis</span>
    <span>
      This compares how countries are set up to govern AI, not how well they do it. Each area is checked against {max} features of
      the {home.short} approach; the count is how many it shares, with “partly” counted as a half.
    </span>
  </p>
  {
    sec.intro.length > 0 && (
      <div class="intro">
        {sec.intro.map((s: any) => (
          <p>
            {s.text}
            <Cite ids={s.sources} index={idx} />
          </p>
        ))}
      </div>
    )
  }

  <h3 class="sub">Structural comparison</h3>
  <ol class="criteria">
    {
      sec.criteria.map((c: any, i: number) => (
        <li>
          <span class="mono">{i + 1}</span> {c.question}
        </li>
      ))
    }
  </ol>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison table">
    <table class="compare">
      <thead>
        <tr>
          <th scope="col">Area</th>
          {sec.criteria.map((c: any, i: number) => <th scope="col" title={c.question}><span class="mono">{i + 1}</span> {c.short}</th>)}
          <th scope="col" class="num">Shared</th>
        </tr>
      </thead>
      <tbody>
        <tr class="home-row">
          <th scope="row">{home.name} <span class="mono">(reference)</span></th>
          {sec.criteria.map((c: any) => <td class={`m m-${c.home}`}><span class="dot" aria-hidden="true"></span><span class="m-label">{LABELS.match[c.home]}</span></td>)}
          <td class="num mono">{fmt(score(homeAnswers))} of {max}</td>
        </tr>
        {
          bands.map((b) => {
            const inBand = rows.filter((r: any) => b.test(r.score));
            if (!inBand.length) return null;
            return (
              <>
                <tr class="band">
                  <th colspan={max + 2} scope="rowgroup">{b.title}</th>
                </tr>
                {inBand.map((r: any) => (
                  <tr id={`cmp-${r.code.toLowerCase()}`}>
                    <th scope="row">
                      <span class="row-name">{r.name}</span>
                      <span class="row-approach">
                        {r.approach}
                        <Cite ids={r.sources} index={idx} />
                      </span>
                    </th>
                    {sec.criteria.map((c: any) => (
                      <td class={`m m-${r.answers[c.key]}`}>
                        <span class="dot" aria-hidden="true"></span><span class="m-label">{LABELS.match[r.answers[c.key]]}</span>
                      </td>
                    ))}
                    <td class="num mono">{fmt(r.score)} of {max}</td>
                  </tr>
                ))}
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>

  {
    sec.approaches.length > 0 && (
      <>
        <h3 class="sub">The main approaches, and what is known about how well they work</h3>
        <div class="approaches">
          {sec.approaches.map((a: any) => (
            <article class="approach" id={`approach-${a.key}`}>
              <h4>{a.name}</h4>
              <p class="used-by">
                {a.used_by.map((c: string) => (
                  <span class="chip">{areaNames[c] ?? c}</span>
                ))}
              </p>
              <p>
                {a.description.text}
                <Cite ids={a.description.sources} index={idx} />
              </p>
              <h5 class="label">Evidence so far</h5>
              <ul class="statements">
                {a.evidence.map((s: any) => (
                  <li>
                    {s.text}
                    <Cite ids={s.sources} index={idx} />
                  </li>
                ))}
              </ul>
              {a.limits.length > 0 && (
                <>
                  <h5 class="label">Limits and open questions</h5>
                  <ul class="statements">
                    {a.limits.map((s: any) => (
                      <li>
                        {s.text}
                        <Cite ids={s.sources} index={idx} />
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </article>
          ))}
        </div>
      </>
    )
  }

  {
    sec.cooperation.length > 0 && (
      <>
        <h3 class="sub">Shared international frameworks</h3>
        <ol class="coop">
          {sec.cooperation.map((c: any) => (
            <li>
              <div class="coop-when mono">{fmtDate(c.date)}</div>
              <div class="coop-what">
                <h4>{c.name}</h4>
                <p>
                  {c.text}
                  <Cite ids={c.sources} index={idx} />
                </p>
                {c.home_role && (
                  <p class="coop-role">
                    <span class="label">{home.short} role</span> {c.home_role}
                  </p>
                )}
                {c.principles.length > 0 && (
                  <p class="coop-overlap">
                    <span class="label">Overlaps with</span>{' '}
                    {c.principles.map((k: string) => (
                      <a class="chip" href={`#principle-${k}`}>
                        {LABELS.principle_short[k]}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </>
    )
  }
  {sec.meta.gaps && <p class="gaps"><span class="label">Gaps</span> {sec.meta.gaps}</p>}
</section>

<style>
  .intro {
    display: grid;
    gap: 10px;
    max-width: var(--measure);
  }
  .sub {
    font-size: var(--step-2);
    margin-top: 10px;
  }
  .criteria {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .criteria .mono {
    display: inline-block;
    width: 1.4em;
    color: var(--ink-3);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .compare {
    border-collapse: collapse;
    width: 100%;
    min-width: 820px;
    font-size: 0.875rem;
  }
  .compare th,
  .compare td {
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }
  .compare thead th {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--ink-3);
    background: var(--paper-2);
    vertical-align: bottom;
  }
  .compare tbody th {
    font-weight: 400;
    width: 34%;
  }
  .row-name {
    display: block;
    font-weight: 600;
  }
  .row-approach {
    display: block;
    color: var(--ink-2);
    font-size: 0.8125rem;
    margin-top: 2px;
  }
  .home-row th,
  .home-row td {
    background: color-mix(in srgb, var(--covered) 8%, transparent);
    font-weight: 600;
  }
  .band th {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--ink-2);
    background: var(--paper-2);
    width: auto;
  }
  .m {
    white-space: nowrap;
  }
  .m-yes {
    color: var(--covered);
  }
  .m-partly {
    color: var(--ink-2);
  }
  .m-no {
    color: var(--select-ink);
  }
  .m-label {
    font-size: 0.8125rem;
  }
  .dot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 6px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    vertical-align: -0.05em;
  }
  .m-yes .dot {
    background: currentColor;
  }
  .m-partly .dot {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
  .num {
    text-align: right;
    white-space: nowrap;
  }
  .approaches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .approach {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }
  .approach h4 {
    font-size: var(--step-1);
  }
  .approach h5 {
    margin: 6px 0 0;
  }
  .used-by {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .coop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .coop li {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--rule);
  }
  .coop-when {
    color: var(--ink-2);
  }
  .coop-what {
    display: grid;
    gap: 6px;
    max-width: var(--measure);
  }
  .coop-what h4 {
    font-size: var(--step-1);
  }
  .coop-role,
  .coop-overlap {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .coop-overlap .chip {
    text-decoration: none;
    margin-right: 4px;
  }
  .coop-role .label,
  .coop-overlap .label {
    margin-right: 6px;
  }
  @media (max-width: 600px) {
    .coop li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
