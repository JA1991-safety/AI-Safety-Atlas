---
// Areas for improvement in AI safety. Each area sets what is already in place beside what a named
// source has identified, so the section reads in balance. Approaches used elsewhere are for information.
import Cite from './Cite.astro';
import { LABELS, fmtDate } from '../lib/site.mjs';

const { p, idx, areaNames } = Astro.props as any;
const sec = p.areas_for_improvement;
const nameOf = (c: string) => areaNames[c] ?? c;
const shortOf = Object.fromEntries((p.principles?.items ?? []).map((i: any) => [i.key, i.short]));
const frameName = p.principles?.framework.name ?? 'the principles';
---
<section id="improvement" class="section" aria-labelledby="h-improvement">
  <header class="section-head">
    <h2 id="h-improvement">Areas for Improvement in AI Safety</h2>
    <p class="section-meta mono">
      Checked {fmtDate(sec.meta.checked)} · {LABELS.evidence_depth[sec.meta.evidence_depth]} · {LABELS.review[sec.meta.review]}
    </p>
  </header>
  <p class="analysis-note">
    <span class="pill pill-analysis">About this section</span>
    <span>
      Each area shows what is already in place and what named sources have identified, using {frameName} as a frame.
      Approaches used in other countries, or proposed at home, are listed to help understanding, not as recommendations.
    </span>
  </p>
  {
    sec.intro.length > 0 && (
      <div class="intro">
        {sec.intro.map((s: any) => (
          <p>
            {s.text}
            <Cite ids={s.sources} index={idx} />
          </p>
        ))}
      </div>
    )
  }
  <ol class="area-list">
    {
      sec.items.map((g: any) => (
        <li class="area" id={`improve-${g.id}`}>
          <div class="area-tags">
            <span class="kind">{LABELS.improvement_kind[g.kind]}</span>
            {g.principles.map((k: string) => (
              <a class="chip" href={`#principle-${k}`}>
                {shortOf[k] ?? k}
              </a>
            ))}
          </div>
          <h3>{g.title}</h3>
          <dl class="balance">
            <div>
              <dt class="label">In place</dt>
              <dd>
                {g.in_place.text}
                <Cite ids={g.in_place.sources} index={idx} />
              </dd>
            </div>
            <div>
              <dt class="label">Identified for improvement</dt>
              <dd>
                {g.identified.text}
                <Cite ids={g.identified.sources} index={idx} />
              </dd>
            </div>
          </dl>
          {g.elsewhere.length > 0 && (
            <div class="options">
              <h4 class="label">Approaches used elsewhere</h4>
              <ul>
                {g.elsewhere.map((o: any) => (
                  <li>
                    <span>
                      {o.text}
                      <Cite ids={o.sources} index={idx} />
                    </span>
                    <span class="where">
                      {o.used_in.length > 0 && (
                        <>
                          <span class="mono">Used in</span> {o.used_in.map((c: string) => <span class="chip">{nameOf(c)}</span>)}
                        </>
                      )}
                      {o.proposed_by && (
                        <>
                          <span class="mono">Proposed by</span> <span class="chip chip-wrap">{o.proposed_by}</span>
                        </>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ol>
  {sec.meta.gaps && <p class="gaps"><span class="label">Gaps</span> {sec.meta.gaps}</p>}
</section>

<style>
  .intro {
    display: grid;
    gap: 10px;
    max-width: var(--measure);
  }
  .area-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .area {
    display: grid;
    gap: 8px;
    padding-block: 18px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: var(--anchor-offset, 120px);
  }
  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .area-tags .chip {
    text-decoration: none;
  }
  .kind {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
    color: var(--ink-2);
    margin-right: 4px;
  }
  .area h3 {
    font-size: var(--step-1);
  }
  .balance {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 10px 24px;
    max-width: 960px;
  }
  .balance div {
    display: grid;
    gap: 4px;
    align-content: start;
    min-width: 0;
  }
  .balance dd {
    margin: 0;
  }
  .options {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border-left: 3px solid var(--covered-soft);
    background: var(--paper-2);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 860px;
  }
  .options h4 {
    margin: 0;
  }
  .options ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 10px;
    font-size: 0.9375rem;
  }
  .options li {
    display: grid;
    gap: 4px;
  }
  .chip-wrap {
    white-space: normal;
    max-width: 100%;
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    align-items: baseline;
    color: var(--ink-3);
  }
</style>
